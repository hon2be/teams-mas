# Azure Portal → App registrations → 개요에서 그대로 복사
# Application (client) ID
VITE_ENTRA_CLIENT_ID=
# Directory (tenant) ID. 사내 단일 테넌트면 이 GUID, 여러 조직 배포면 organizations
VITE_ENTRA_TENANT_ID=

# Teams 앱 패키지 식별자. 위 client ID 와 다른 값이며, 아무 GUID나 새로 만들면 된다.
# 생성: node -e "console.log(crypto.randomUUID())"
VITE_TEAMS_APP_ID=

# SharePoint 저장소 (PRD §11). 예: contoso.sharepoint.com / /sites/MAS
VITE_SHAREPOINT_HOSTNAME=
VITE_SHAREPOINT_SITE_PATH=

# 배포된 앱의 origin. manifest 패키징에 쓰인다. 예: https://mas.contoso.com
VITE_APP_ORIGIN=

# 서브경로 배포용. GitHub Pages 프로젝트 페이지면 /<저장소명>/ 예: /teams-mas/
VITE_BASE_PATH=

# 리라이트 없는 정적 호스팅(GitHub Pages)이면 hash. 그 외에는 비워 둔다.
VITE_ROUTER=
