{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.3.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "MAS",
    "websiteUrl": "{{APP_ORIGIN}}",
    "privacyUrl": "{{APP_ORIGIN}}/privacy",
    "termsOfUseUrl": "{{APP_ORIGIN}}/terms"
  },
  "name": {
    "short": "MAS",
    "full": "Meeting Availability Scheduler"
  },
  "description": {
    "short": "회의 가능 시간 수집과 추천",
    "full": "Teams 채팅과 채널에서 참석 가능 시간을 수집하고 최적 회의 시간을 추천합니다."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#4643D9",
  "staticTabs": [
    {
      "entityId": "mas.home",
      "name": "회의 조율",
      "contentUrl": "{{APP_ORIGIN}}/{{ROUTE_PREFIX}}",
      "websiteUrl": "{{APP_ORIGIN}}/{{ROUTE_PREFIX}}",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "{{APP_ORIGIN}}/{{ROUTE_PREFIX}}config",
      "canUpdateConfiguration": true,
      "scopes": ["groupChat", "team"],
      "context": ["channelTab", "privateChatTab", "meetingChatTab", "meetingDetailsTab"]
    }
  ],
  "webApplicationInfo": {
    "id": "{{ENTRA_CLIENT_ID}}",
    "resource": "api://{{APP_HOST}}/{{ENTRA_CLIENT_ID}}"
  },
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["{{APP_HOST}}"]
}
